# Copy this file to .env.local for local development.
# Create a dedicated MongoDB Atlas database user with access only to this app's database.
# URL-encode special characters in the username/password portion of the connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=theworld

# Optional compatible MapLibre style. Defaults to OpenFreeMap dark.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
